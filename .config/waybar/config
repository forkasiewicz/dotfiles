{
  "layer": "top",
  "position": "bottom",
  "modules-left": [],
  "modules-center": [],
  "modules-right": [
    "cpu", "memory", "pulseaudio", "clock#canberra", "clock"
  ],

  "clock": {
    "tooltip": false,
    "format": "{:%H:%M:%S}",
    "interval": 5
  },

  "clock#canberra": {
    "tooltip": false,
    "format": "{:%H:%M}",
    "interval": 60,
    "timezone": "Australia/Canberra"
  },
  
  "cpu": {
    "format": "CPU: {usage}%",
    "tooltip": true
  },
  
  "memory": {
    "format": "RAM: {used:0.1f}GiB",
    "tooltip": false
  },
  
  "pulseaudio": {
    "format": "VOL: {volume}%",
    "format-muted": "MUTED",
    "tooltip": false,
    "interval": 1000
  }
}

set $super Mod4

font pango:Iosevka

floating_modifier $super

bindsym $super+Return exec alacritty
bindsym $super+d exec rofi -show drun
bindsym $super+e exec pcmanfm
bindsym $super+c kill
bindsym $super+Shift+e exit
bindsym $super+BackSpace exec "i3-msg restart"

bindsym $super+h focus left
bindsym $super+j focus down
bindsym $super+k focus up
bindsym $super+l focus right

bindsym $super+Shift+h move left
bindsym $super+Shift+j move down
bindsym $super+Shift+k move up
bindsym $super+Shift+l move right

bindsym $super+v split vertical
bindsym $super+f split horizontal
bindsym $super+s layout toggle split
bindsym $super+Shift+space floating toggle

bindsym $super+t layout tabbed
bindsym $super+Left focus left
bindsym $super+Right focus right

bindsym --whole-window $super+button4 workspace next
bindsym --whole-window $super+button5 workspace prev

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $super+1 workspace $ws1
bindsym $super+2 workspace $ws2
bindsym $super+3 workspace $ws3
bindsym $super+4 workspace $ws4
bindsym $super+5 workspace $ws5
bindsym $super+6 workspace $ws6
bindsym $super+7 workspace $ws7
bindsym $super+8 workspace $ws8
bindsym $super+9 workspace $ws9

bindsym $super+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $super+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $super+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $super+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $super+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $super+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $super+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $super+Shift+8 move container to workspace $ws8; workspace $ws8
bindsym $super+Shift+9 move container to workspace $ws9; workspace $ws9

bindsym Print exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

exec_always --no-startup-id feh /home/c/.config/wallpapers/lete.jpg --bg-fill
exec --no-startup-id polybar main
exec --no-startup-id xrandr --output DP-2 --mode 2560x1440 --rate 239.96
exec --no-startup-id alttab -d 1
exec --no-startup-id xset r rate 250 30

for_window [class="Pcmanfm"] floating enable
for_window [class="mpv"] floating enable
for_window [class="qimgv"] floating enable
for_window [class="FileRoller"] floating enable
for_window [class="pavucontrol"] floating enable

default_border pixel
default_floating_border normal

client.focused          #2b2b35 #505770 #cdcdcd #f3be7c #2b2b35
client.focused_inactive #24242e #2f2f3c #cdcdcd #f3be7c #24242e
client.unfocused        #1c1c24 #141415 #cdcdcd #aaaaaa #1c1c24
client.urgent           #d8647e #f3be7c #ffffff #f3be7c #d8647e
client.placeholder      #333738 #1c1c24 #cdcdcd #aaaaaa #1c1c24

for_window [class="^.*"] border pixel 3
default_floating_border none
